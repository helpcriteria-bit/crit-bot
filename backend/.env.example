# Server Configuration
PORT=3001
NODE_ENV=production

# Groq API Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# CORS Configuration
# For multiple origins, separate with commas: https://your-site.vercel.app,http://localhost:5173
CORS_ORIGIN=https://crit-bot.web.app,http://localhost:5173,http://localhost:3000
